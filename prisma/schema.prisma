generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Platform {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  license     String?
  rating      Float?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  promotions  Promotion[]
  claims      Claim[]
}

model Promotion {
  id          String   @id @default(cuid())
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id])
  title       String
  description String?
  value       String
  label       String
  condition   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Claim {
  id          String   @id @default(cuid())
  platformId  String
  platform    Platform @relation(fields: [platformId], references: [id])
  title       String
  summary     String
  status      String   @default("pending")
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
